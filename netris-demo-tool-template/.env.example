# Target Netris Controller API
NETRIS_URL=https://adam-ctl.netris.io
NETRIS_USERNAME=netris
NETRIS_PASSWORD=your-controller-password-here
NETRIS_VERIFY_SSL=false

# Service Port and Host
PORT=8750
HOST=0.0.0.0

# Optional Jump Host / Switch Credentials (if interacting with switches directly)
SSH_JUMP_HOST=adam-ctl.netris.io
SSH_JUMP_PORT=22
SSH_JUMP_USER=ubuntu
SSH_SWITCH_USER=cumulus

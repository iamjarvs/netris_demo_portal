# Copy this to .env and fill in real values. .env is gitignored - never commit it.
# Targets NetBox v4.7 (netbox-docker release 5.1.0).

# --- NetBox ---
NETBOX_SECRET_KEY=generate-a-random-64-char-hex-string
# Must be >= 50 chars - used to hash v2 API tokens (NetBox 4.5+). Generate with: openssl rand -hex 32
NETBOX_API_TOKEN_PEPPER=generate-a-random-64-char-hex-string
NETBOX_SUPERUSER_PASSWORD=changeme
NETBOX_REDIS_PASSWORD=changeme
NETBOX_REDIS_CACHE_PASSWORD=changeme
POSTGRES_PASSWORD=changeme

# --- Netris ---
NETRIS_URL=https://your-controller.netris.io
NETRIS_USER=netris
NETRIS_PASSWORD=changeme

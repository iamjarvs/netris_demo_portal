# ==============================================================================
# Netris Observability Stack Configuration
# ==============================================================================
# All general operational, networking, and service parameters that can be tuned.

# ------------------------------------------------------------------------------
# 1. Exporter Telemetry & Refresh Timings
# ------------------------------------------------------------------------------
# Interval (in seconds) to re-query Netris Controller for topology changes,
# newly cabled switch ports, updated VPCs, and server cluster bindings.
METADATA_REFRESH_INTERVAL=300

# Timeout (in seconds) for HTTP requests against Netris Controller endpoints
SCRAPE_TIMEOUT=20

# Exporter log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 2. Port Bindings
# ------------------------------------------------------------------------------
# Host interface to bind the exporter to (0.0.0.0 listens on all interfaces)
EXPORTER_HOST=0.0.0.0

# Port exposed by the Python Netris Prometheus Exporter
EXPORTER_PORT=9101

# Port exposed by the local Prometheus server UI
PROMETHEUS_PORT=9090

# Port exposed by the local Grafana dashboards UI
GRAFANA_PORT=3000

# ------------------------------------------------------------------------------
# 3. Streaming Telemetry & Time-Series Graphs
# ------------------------------------------------------------------------------
# Enable querying Netris embedded Graphite engine for live interface octets/rates
ENABLE_STREAMING_TRAFFIC=true

# Enable interface packet rate streaming (PPS in/out, unicast/multicast/broadcast)
ENABLE_STREAMING_PPS=true

# Enable interface error and discard streaming (errors/s, drops/s)
ENABLE_STREAMING_ERRORS=true

# Enable optical transceiver physical layer telemetry (RX power dBm)
ENABLE_STREAMING_OPTICS=true

# Enable switch and SoftGate system compute telemetry (CPU cores, memory, NAT conntrack)
ENABLE_STREAMING_SYSTEM=true

# Enable MariaDB relational telemetry (VPN SLA mesh, FIB/MAC capacity, TCAM quotas, L4LB)
ENABLE_MARIADB_TELEMETRY=true

# Enable MongoDB Telescope sensor telemetry (ASIC temps, fan RPM, PSU status, BER, daemons)
ENABLE_MONGODB_SENSORS=true

# If true, emits metrics for ports with non-zero traffic OR active server/spine links,
# filtering out inactive disconnected down ports to keep Prometheus TSDB lean and ultra-responsive.
STREAMING_TRAFFIC_ACTIVE_ONLY=true

# ------------------------------------------------------------------------------
# 4. Offline Simulation Replay Mode
# ------------------------------------------------------------------------------
# When true, the exporter does NOT connect to Netris Controller and replays
# recorded telemetry from the specified data file in an infinite loop.
SIMULATION_MODE=false
SIM_DATA_FILE=sim_data/telemetry_recording.json

# ------------------------------------------------------------------------------
# 5. Grafana Authentication
# ------------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

    {
      "id": 101,
      "title": "Peak ASIC Temperature (\u00b0C)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "max(netris_sensor_temperature_celsius{sensor_type=\"asic\"}) or max(netris_sensor_temperature_celsius)",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "celsius",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#76B900",
                "value": null
              },
              {
                "color": "#FF9900",
                "value": 65
              },
              {
                "color": "#FF3366",
                "value": 75
              }
            ]
          }
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"

    {
      "id": 101,
      "title": "Connected HGX GPU Servers",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "description": "Total HGX supercomputing compute nodes connected to the Nexus leaf fabric.",
      "targets": [
        {
          "expr": "count(netris_device_info{device_role=\"server\"}) or vector(0)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#76B900"
          },
          "unit": "short"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {
      "id": 102,
      "title": "Cluster Workload Tenants / VPCs",
      "type": "stat",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 4
      },
      "description": "Total active isolated tenant VPCs partitioned across the Nexus fabric.",
      "targets": [
        {
          "expr": "count(count by (vpc) (netris_port_status{vpc!=\"none\"})) or vector(2)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#00F5D4"
          },
          "unit": "short"
        }
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      }
    },
    {

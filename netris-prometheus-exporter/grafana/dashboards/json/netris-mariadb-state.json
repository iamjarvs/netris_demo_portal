            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#76B900",
                "value": null
              },
              {
                "color": "#FF9900",
                "value": 30
              },
              {
                "color": "#FF3366",
                "value": 60
              }
            ]
          }
